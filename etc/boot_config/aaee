#!/bin/bash
AAEE_HOME=$(dirname `which aaee`)
# Include LD_LIBRARY from local env
AAEE_DEFAULT_LD_LIB_PATH="${AAEE_HOME}/../lib"
if [[ -d "${AAEE_EDA_LD_LIB_PATH}" ]]; then
  echo "Include the default lib path"
  export LD_LIBRARY_PATH=${AAEE_DEFAULT_LD_LIB_PATH}:${LD_LIBRARY_PATH}
fi
# Include LD_LIBRARY_PATH if a custom env is available
AAEE_EDA_LD_LIB_PATH="${AAEE_HOME}/../env/eda/lib"
if [[ -d "${AAEE_EDA_LD_LIB_PATH}" ]]; then
  echo "Include the EDA lib path as the top priority"
  export LD_LIBRARY_PATH=${AAEE_EDA_LD_LIB_PATH}:${LD_LIBRARY_PATH}
fi
${AAEE_HOME}/arkangel --root_path ${AAEE_HOME}/../ --boot_config ${AAEE_HOME}/../etc/boot_config/install.xml $@
