#!/usr/bin/env bash

# ══════════════════════════════════════════════════════════════
# AAEE Launcher — Supports Linux, macOS, Windows (MSYS2/MinGW),
#                 and native Windows (via .bat shim detection)
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# Auto-detect OS
# ──────────────────────────────────────────────
detect_os() {
  case "$(uname -s)" in
    Linux*)             echo "linux" ;;
    Darwin*)            echo "mac" ;;
    MINGW* | MSYS*)     echo "windows_msys2" ;;
    CYGWIN*)            echo "windows_cygwin" ;;
    *)
      # Fallback: check for Windows env vars in case uname is unavailable
      if [[ -n "${WINDIR}" || -n "${SystemRoot}" ]]; then
        echo "windows_native"
      else
        echo "unknown"
      fi
      ;;
  esac
}

OS=$(detect_os)
echo "Detected OS: ${OS}"

# ──────────────────────────────────────────────
# Resolve AAEE_HOME
# ──────────────────────────────────────────────
resolve_aaee_home() {
  local bin

  # Try aaee first, then aaee.exe for Windows environments
  bin=$(which aaee 2>/dev/null || which aaee.exe 2>/dev/null)

  if [[ -z "${bin}" ]]; then
    echo "ERROR: Could not locate 'aaee' or 'aaee.exe' in PATH." >&2
    exit 1
  fi

  dirname "$(realpath "${bin}" 2>/dev/null || readlink -f "${bin}" 2>/dev/null || echo "${bin}")"
}

AAEE_HOME=$(resolve_aaee_home)
echo "AAEE_HOME: ${AAEE_HOME}"

# ──────────────────────────────────────────────
# Common paths
# ──────────────────────────────────────────────
AAEE_DEFAULT_LIB_PATH="${AAEE_HOME}/../lib"
AAEE_EDA_LIB_PATH="${AAEE_HOME}/../env/eda/lib"
AAEE_ROOT="${AAEE_HOME}/../"
AAEE_BOOT_CONFIG="${AAEE_HOME}/../etc/boot_config/install.xml"

# ──────────────────────────────────────────────
# OS-specific setup
# ──────────────────────────────────────────────
case "${OS}" in

  linux | mac)
    # ── Unix: use LD_LIBRARY_PATH ──
    if [[ -d "${AAEE_DEFAULT_LIB_PATH}" ]]; then
      echo "Including default lib path (Unix)"
      export LD_LIBRARY_PATH="${AAEE_DEFAULT_LIB_PATH}:${LD_LIBRARY_PATH}"
    fi

    if [[ -d "${AAEE_EDA_LIB_PATH}" ]]; then
      echo "Including EDA lib path as top priority (Unix)"
      export LD_LIBRARY_PATH="${AAEE_EDA_LIB_PATH}:${LD_LIBRARY_PATH}"
    fi

    AAEE_BIN="${AAEE_HOME}/arkangel"
    ;;

  windows_msys2 | windows_cygwin)
    # ── MSYS2/MinGW/Cygwin: use PATH for DLL resolution ──
    if [[ -d "${AAEE_DEFAULT_LIB_PATH}" ]]; then
      echo "Including default lib path (MSYS2/Cygwin)"
      export PATH="${AAEE_DEFAULT_LIB_PATH}:${PATH}"
    fi

    if [[ -d "${AAEE_EDA_LIB_PATH}" ]]; then
      echo "Including EDA lib path as top priority (MSYS2/Cygwin)"
      export PATH="${AAEE_EDA_LIB_PATH}:${PATH}"
    fi

    AAEE_BIN="${AAEE_HOME}/arkangel.exe"
    ;;

  windows_native)
    # ── Native Windows: emit a .bat launcher and invoke it ──
    echo "Native Windows detected — generating .bat launcher..."

    # Convert MSYS/Unix-style paths to Windows paths if cygpath is available
    if command -v cygpath &>/dev/null; then
      WIN_HOME=$(cygpath -w "${AAEE_HOME}")
      WIN_DEFAULT_LIB=$(cygpath -w "${AAEE_DEFAULT_LIB_PATH}")
      WIN_EDA_LIB=$(cygpath -w "${AAEE_EDA_LIB_PATH}")
      WIN_ROOT=$(cygpath -w "${AAEE_ROOT}")
      WIN_BOOT_CONFIG=$(cygpath -w "${AAEE_BOOT_CONFIG}")
    else
      WIN_HOME="${AAEE_HOME}"
      WIN_DEFAULT_LIB="${AAEE_DEFAULT_LIB_PATH}"
      WIN_EDA_LIB="${AAEE_EDA_LIB_PATH}"
      WIN_ROOT="${AAEE_ROOT}"
      WIN_BOOT_CONFIG="${AAEE_BOOT_CONFIG}"
    fi

    BAT_FILE="${AAEE_HOME}/aaee_launch.bat"
    cat > "${BAT_FILE}" <<EOF
@echo off
REM Auto-generated AAEE launcher for native Windows
REM Generated by aaee cross-platform launch script

SET AAEE_HOME=${WIN_HOME}

REM Include default lib path
IF EXIST "%AAEE_HOME%\..\lib" (
    echo Including default lib path (Windows native)
    SET "PATH=${WIN_DEFAULT_LIB};%PATH%"
)

REM Include EDA lib path as top priority
IF EXIST "%AAEE_HOME%\..\env\eda\lib" (
    echo Including EDA lib path as top priority (Windows native)
    SET "PATH=${WIN_EDA_LIB};%PATH%"
)

REM Launch arkangel
"%AAEE_HOME%\arkangel.exe" --root_path "${WIN_ROOT}" --boot_config "${WIN_BOOT_CONFIG}" %*
EOF

    echo "Launcher written to: ${BAT_FILE}"

    # Execute the .bat file if cmd.exe is reachable
    if command -v cmd.exe &>/dev/null; then
      echo "Executing via cmd.exe..."
      cmd.exe /c "${BAT_FILE}" "$@"
    else
      echo "WARNING: cmd.exe not found. Please run manually: ${BAT_FILE}"
    fi
    exit 0
    ;;

  *)
    echo "ERROR: Unsupported or unrecognised operating system: '${OS}'" >&2
    echo "       Supported: linux, mac, windows_msys2, windows_cygwin, windows_native" >&2
    exit 1
    ;;
esac

# ──────────────────────────────────────────────
# Validate binary (Unix + MSYS2/Cygwin paths)
# ──────────────────────────────────────────────
if [[ ! -f "${AAEE_BIN}" ]]; then
  echo "ERROR: Binary not found: ${AAEE_BIN}" >&2
  exit 1
fi

# ──────────────────────────────────────────────
# Launch
# ──────────────────────────────────────────────
echo "Launching: ${AAEE_BIN}"
"${AAEE_BIN}" \
  --root_path "${AAEE_ROOT}" \
  --boot_config "${AAEE_BOOT_CONFIG}" \
  "$@"
