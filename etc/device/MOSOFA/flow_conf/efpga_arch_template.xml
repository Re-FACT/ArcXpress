<?xml version="1.0"?>
<efpga_arch_template>
  <flow_settings>
    <synth>
      <pdk name="sky130">
        <sdc>${ROOT_PATH}/etc/device/MOSOFA/synth/sdc</sdc>
        <strategy>${ROOT_PATH}/etc/device/MOSOFA/synth/config/sky130_synth_strategies.xml</strategy>
        <ccff_max_fanout>33</ccff_max_fanout>
      </pdk>
    </synth>
    <floorplan>
      <pdk name="sky130">
        <strategy>${ROOT_PATH}/etc/device/MOSOFA/floorplan/sky130_floorplan_strategy.xml</strategy>
      </pdk>
    </floorplan>
    <qorso>
      <task name="leakage" type="leakage">
        <pdk name="sky130">
          <config>${ROOT_PATH}/etc/device/MOSOFA/qor_signoff/strategy/sky130/leakage.xml</config>
        </pdk>
      </task>
      <task name="power_config" type="config_power">
        <pdk name="sky130">
          <config>${ROOT_PATH}/etc/device/MOSOFA/qor_signoff/strategy/sky130/config_power.xml</config>
        </pdk>
      </task>
      <task name="timing_clb" type="timing">
        <pdk name="sky130">
          <config>${ROOT_PATH}/etc/device/MOSOFA/qor_signoff/strategy/sky130/timing_clb.xml</config>
        </pdk>
      </task>
      <task name="timing_io" type="timing">
        <pdk name="sky130">
          <config>${ROOT_PATH}/etc/device/MOSOFA/qor_signoff/strategy/sky130/timing_io.xml</config>
        </pdk>
      </task>
      <task name="timing_gclk" type="timing_gclk">
        <pdk name="sky130">
          <config>${ROOT_PATH}/etc/device/MOSOFA/qor_signoff/strategy/sky130/timing_gclk.xml</config>
        </pdk>
      </task>
      <task name="timing_grst" type="timing_grst">
        <pdk name="sky130">
          <config>${ROOT_PATH}/etc/device/MOSOFA/qor_signoff/strategy/sky130/timing_grst.xml</config>
        </pdk>
      </task>
      <task name="timing_cb" type="timing">
        <pdk name="sky130">
          <config>${ROOT_PATH}/etc/device/MOSOFA/qor_signoff/strategy/sky130/timing_cb.xml</config>
        </pdk>
      </task>
      <task name="timing_sb" type="timing">
        <pdk name="sky130">
          <config>${ROOT_PATH}/etc/device/MOSOFA/qor_signoff/strategy/sky130/timing_sb.xml</config>
        </pdk>
      </task>
    </qorso>
  </flow_settings>
  <builtin_corner_map>
<pdk name="sky130" default="tt_025C_1v80">
  <corner name="ff_100C_1v95">
    <sclib>ff_100C_1v95</sclib>
    <spef>cn_25C</spef>
  </corner>
   <corner name="ss_n40C_1v35">
    <sclib>ss_n40C_1v35</sclib>
    <spef>cn_25C</spef>
  </corner>
  <corner name="tt_025C_1v80">
    <sclib>tt_025C_1v80</sclib>
    <spef>cn_25C</spef>
  </corner>
</pdk>
  </builtin_corner_map>
  <arch_template route_chan_width="64">
    <arch_generator>
      <file type="build">${ROOT_PATH}/build/etc/device/MOSOFA/utils/sofa_hd_arch_tmpl_gen</file>
      <file type="install">${ROOT_PATH}/etc/arch_gen/sofa_hd_arch_tmpl_gen</file>
    </arch_generator>
    <io_settings>
      <num_io_per_tile name="NUM_LEFT_PI_PER_TILE" type="input" side="left" msb="MSB_LEFT_PI_PER_TILE"/>
      <num_io_per_tile name="NUM_LEFT_PO_PER_TILE" type="output" side="left" msb="MSB_LEFT_PO_PER_TILE"/>
      <num_io_per_tile name="NUM_LEFT_PO_CKO_PER_TILE" type="output" side="left" max="1" msb="MSB_LEFT_PO_CKO_PER_TILE"/>
      <num_io_per_tile name="NUM_RIGHT_PI_PER_TILE" type="input" side="right" msb="MSB_RIGHT_PI_PER_TILE"/>
      <num_io_per_tile name="NUM_RIGHT_PO_PER_TILE" type="output" side="right" msb="MSB_RIGHT_PO_PER_TILE"/>
      <num_io_per_tile name="NUM_RIGHT_PO_CKO_PER_TILE" type="output" side="right" max="1" msb="MSB_RIGHT_PO_CKO_PER_TILE"/>
      <num_io_per_tile name="NUM_TOP_PI_PER_TILE" type="input" side="top" msb="MSB_TOP_PI_PER_TILE"/>
      <num_io_per_tile name="NUM_TOP_PO_PER_TILE" type="output" side="top" msb="MSB_TOP_PO_PER_TILE"/>
      <num_io_per_tile name="NUM_TOP_PO_CKO_PER_TILE" type="output" side="top" max="1" msb="MSB_TOP_PO_CKO_PER_TILE"/>
      <num_io_per_tile name="NUM_BOTTOM_PI_PDC_ECB_PER_TILE" type="input" side="bottom" max="1"/>
      <num_io_per_tile name="NUM_BOTTOM_PI_PER_TILE" type="input" side="bottom" msb="MSB_BOTTOM_PI_PER_TILE"/>
      <num_io_per_tile name="NUM_BOTTOM_PO_PER_TILE" type="output" side="bottom" msb="MSB_BOTTOM_PO_PER_TILE"/>
      <num_io_per_tile name="NUM_BOTTOM_PO_CKO_PER_TILE" type="output" side="bottom" max="1"/>
      <io_type name="TOP_IO_TYPE" side="top"/>
      <io_type name="RIGHT_IO_TYPE" side="right"/>
      <io_type name="BOTTOM_IO_TYPE" side="bottom"/>
      <io_type name="LEFT_IO_TYPE" side="left"/>
    </io_settings>
    <yosys_error_conf>${ROOT_PATH}/etc/device/MOSOFA/flow_conf/log_error_keywords.xml</yosys_error_conf>
    <openfpga_error_conf>${ROOT_PATH}/etc/device/MOSOFA/flow_conf/log_error_keywords.xml</openfpga_error_conf>
    <openfpga_stats_conf>${ROOT_PATH}/etc/device/MOSOFA/flow_conf/openfpga_log_keywords.xml</openfpga_stats_conf>
    <!-- Only applicable to ultimate fabric -->
    <arch_timing pdk_template="t22ulp" file_template="tt_25C_v0p9">
      <pdk name="sky130">
        <file type="tt_25C_v1p1">${ROOT_PATH}/etc/device/MOSOFA/arch/ultimate/sky130_timing/arch_timing_tt_25C_v1p1.yml</file>
        <file type="tt_25C_v0p9">${ROOT_PATH}/etc/device/MOSOFA/arch/ultimate/sky130_timing/arch_timing_tt_25C_v0p9.yml</file>
        <file type="tt_25C_v1p0">${ROOT_PATH}/etc/device/MOSOFA/arch/ultimate/sky130_timing/arch_timing_tt_25C_v1p0.yml</file>
        <file type="ffg_25C_v1p1">${ROOT_PATH}/etc/device/MOSOFA/arch/ultimate/sky130_timing/arch_timing_ffg_25C_v1p1.yml</file>
        <file type="ffg_ccs_25C_v1p1">${ROOT_PATH}/etc/device/MOSOFA/arch/ultimate/sky130_timing/arch_timing_ffg_ccs_25C_v1p1.yml</file>
      </pdk>
    </arch_timing>
    <dp>
      <file type="vpr_arch">${ROOT_PATH}/etc/device/MOSOFA/arch/dp/vpr_arch.xml</file>
      <file type="openfpga_arch">${ROOT_PATH}/etc/device/MOSOFA/arch/dp/openfpga_arch.xml</file>
      <file type="openfpga_global_network_arch">${ROOT_PATH}/etc/device/MOSOFA/arch/dp/openfpga_global_network.xml</file>
      <file type="openfpga_clock_buffer_location_map">${ROOT_PATH}/etc/device/MOSOFA/arch/dp/ckbuf_loc_map.xml</file>
      <file type="design_variables">${ROOT_PATH}/etc/device/MOSOFA/arch/dp/arch_var.yml</file>
    </dp>
    <ultimate>
      <file type="vpr_arch">${ROOT_PATH}/etc/device/MOSOFA/arch/ultimate/vpr_arch.xml</file>
      <file type="openfpga_arch">${ROOT_PATH}/etc/device/MOSOFA/arch/ultimate/openfpga_arch.xml</file>
      <file type="openfpga_global_network_arch">${ROOT_PATH}/etc/device/MOSOFA/arch/ultimate/openfpga_global_network.xml</file>
      <file type="openfpga_clock_buffer_location_map">${ROOT_PATH}/etc/device/MOSOFA/arch/ultimate/ckbuf_loc_map.xml</file>
      <file type="design_variables">${ROOT_PATH}/etc/device/MOSOFA/arch/ultimate/arch_var.yml</file>
    </ultimate>
    <netlist_flags>
      <pdk name="sky130">
        <flag name="S40ULP_7T">1</flag>
      </pdk>
      <pdk name="t22ulp">
        <flag name="T22ULP">1</flag>
      </pdk>
      <pdk name="s180bcd">
        <flag name="S180BCD_6T">1</flag>
      </pdk>
    </netlist_flags>
    <ips>
      <!-- IP MMFF -->
      <file type="ip_rtl" default_nettype="wire">${ROOT_PATH}/etc/device/MOSOFA/ips/digital_io_hd.v</file>
      <!-- Std cell / IP wrappers -->
      <file type="ip_rtl">${ROOT_PATH}/etc/device/MOSOFA/custom_modules/efpga_ccff.v</file>
      <file type="ip_rtl" default_nettype="wire">${ROOT_PATH}/etc/device/MOSOFA/custom_modules/efpga_stdcell_wrapper.v</file>
      <!-- Gate-level IP will be copied to gate-level without any optimization. This may be no longer needed as the direct_interc is synthesis independently during netlist optimizaton from RTl-level netlist -->
      <!-- 
      <file type="ip_gl">${ROOT_PATH}/etc/device/MOSOFA/netlist_wrapper/direct_interc.v</file>
        -->
    </ips>
    <openfpga_settings>
      <file type="openfpga_sim_setting">${ROOT_PATH}/etc/device/MOSOFA/openfpga_settings/efpga_fix_sim_openfpga.xml</file>
      <file type="openfpga_ckbuf_cell_map">${ROOT_PATH}/etc/device/MOSOFA/openfpga_settings/clk_cell_map.xml</file>
      <file type="openfpga_bitstream_setting">${ROOT_PATH}/etc/device/MOSOFA/openfpga_settings/bitstream_settings.xml</file>
      <file type="tile_config">${ROOT_PATH}/etc/device/MOSOFA/openfpga_settings/tile_config.xml</file>
      <file type="gclk_pcf">${ROOT_PATH}/etc/device/MOSOFA/openfpga_settings/pin_constraints_dummy.xml</file>
      <file type="vpr_sdc">${ROOT_PATH}/etc/device/MOSOFA/openfpga_settings/vpr_dummy.sdc</file>
      <file type="pcf">${ROOT_PATH}/etc/device/MOSOFA/openfpga_settings/pcf_dummy.pcf</file>
      <file type="pcf_custom_command">${ROOT_PATH}/etc/device/MOSOFA/openfpga_settings/pcf_custom_command.xml</file>
      <file type="boundary_timing">${ROOT_PATH}/etc/device/MOSOFA/openfpga_settings/boundary_timing.xml</file>
    </openfpga_settings>
    <openfpga_shell_scripts>
      <file type="generate_bitstream">${ROOT_PATH}/etc/device/MOSOFA/openfpga_shell_script/generate_bitstream.openfpga</file>
      <file type="generate_base_bitstream">${ROOT_PATH}/etc/device/MOSOFA/openfpga_shell_script/generate_bitstream_base.openfpga</file>
      <file type="generate_gclk_bitstream">${ROOT_PATH}/etc/device/MOSOFA/openfpga_shell_script/generate_bitstream_gclk.openfpga</file>
      <file type="generate_grst_bitstream">${ROOT_PATH}/etc/device/MOSOFA/openfpga_shell_script/generate_bitstream_gclk.openfpga</file>
      <file type="generate_device_data">${ROOT_PATH}/etc/device/MOSOFA/openfpga_shell_script/generate_device_data.openfpga</file>
      <file type="generate_init_module_names">${ROOT_PATH}/etc/device/MOSOFA/openfpga_shell_script/generate_init_module_names.openfpga</file>
      <file type="generate_init_fabric_key">${ROOT_PATH}/etc/device/MOSOFA/openfpga_shell_script/generate_init_fabric_key.openfpga</file>
      <file type="generate_io_coordinate">${ROOT_PATH}/etc/device/MOSOFA/openfpga_shell_script/generate_io_coordinate.openfpga</file>
      <file type="generate_fabric">${ROOT_PATH}/etc/device/MOSOFA/openfpga_shell_script/generate_fabric.openfpga</file>
      <file type="generate_preconfig_testbench">${ROOT_PATH}/etc/device/MOSOFA/openfpga_shell_script/generate_preconfig_testbench.openfpga</file>
      <file type="generate_full_testbench">${ROOT_PATH}/etc/device/MOSOFA/openfpga_shell_script/generate_full_testbench.openfpga</file>
    </openfpga_shell_scripts>
    <yosys_scripts>
      <file type="synthesis">${ROOT_PATH}/etc/device/MOSOFA/yosys_script/synth.ys</file>
      <file type="rewrite">${ROOT_PATH}/etc/device/MOSOFA/yosys_script/rewrite.ys</file>
      <file type="sweep_k">${ROOT_PATH}/etc/device/MOSOFA/yosys_script/sweep_k.ys</file>
    </yosys_scripts>
    <netlist_makeup_key root="${ROOT_PATH}/etc/device/MOSOFA/netlist_makeup">
      <!-- TODO: Rethink what we need here -->
      <pdk name="sky130">
        <ccff_makeup_buf_config>sky130_ccff_makeup_buf_config.yaml</ccff_makeup_buf_config>
      </pdk>
    </netlist_makeup_key>
    <default_pack_pin_utilization>
      <tile name="io">
        <input_pin_util>1.0</input_pin_util>
        <output_pin_util>1.0</output_pin_util>
      </tile>
      <tile name="clb">
        <input_pin_util>1.0</input_pin_util>
        <output_pin_util>1.0</output_pin_util>
      </tile>
    </default_pack_pin_utilization>
  </arch_template>
</efpga_arch_template>
