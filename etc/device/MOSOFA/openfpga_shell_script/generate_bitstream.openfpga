# Convert .pcf to a .place file that VPR can accept
pcf2place --pcf ${OPENFPGA_PCF} --blif ${VPR_TESTBENCH_BLIF} --pin_table ${OPENFPGA_PIN_TABLE} --fpga_io_map ${OPENFPGA_IO_COORDINATE_FILE} --fpga_fix_pins fix_pins.place.user --pin_table_direction_convention explicit
# Convert pcf timing related info to vpr sdc
pcf2sdc --pcf ${OPENFPGA_PCF} --blif ${VPR_TESTBENCH_BLIF} --pin_table ${OPENFPGA_PIN_TABLE} --pin_table_direction_convention explicit --input_sdc ${OPENFPGA_VPR_SDC} --output_sdc ${OPENFPGA_VPR_FINAL_SDC} --vpr_arch_file ${VPR_ARCH_FILE} --boundary_timing ${OPENFPGA_BOUNDARY_TIMING_FILE} --reduce_error_to_warning  --circuit_format eblif 

# This script is designed to generate bitstream files with 
# - a fixed device layout
# - a fixed routing channel width
# - packing, placement and routing results as a reference for debugging bitstream files
vpr ${VPR_ARCH_FILE} ${VPR_TESTBENCH_BLIF} \
  --pack --place --route --analysis \
  --clock_modeling ideal \
  --device ${OPENFPGA_VPR_DEVICE_LAYOUT} \
  --route_chan_width ${OPENFPGA_VPR_ROUTE_CHAN_WIDTH} \ 
  --circuit_format eblif \
  --fix_clusters fix_pins.place.user \
  --max_router_iterations 400 \
  --read_vpr_constraints ${OPENFPGA_VPR_CONSTRAINT_FILE} \
  --target_ext_pin_util ${OPENFPGA_VPR_TARGET_EXT_PIN_UTILIZATION} \
  --write_block_usage ${OPENFPGA_VPR_BLOCK_USAGE_FILE} \
  --place_delay_model delta \
  --read_placement_delay_lookup ${OPENFPGA_VPR_PLACEMENT_DELAY_LOOKUP_FILE} \
  --read_router_lookahead ${OPENFPGA_VPR_ROUTER_LOOKAHEAD_FILE} \
  --read_rr_graph ${OPENFPGA_VPR_RR_GRAPH_FILE} \
  --net_file ${VPR_NET_FILE} \
  --place_file ${VPR_PLACE_FILE} \
  --route_file ${VPR_ROUTE_FILE} \
  --sdc_file ${OPENFPGA_VPR_FINAL_SDC} \
  --full_stats on \
  --absorb_buffer_luts on \
  --timing_report_detail detailed \
  --timing_report_npaths 100 \
  --skip_sync_clustering_and_routing_results on \
  --gen_post_synthesis_netlist on \
  --constant_net_method route 


# Read OpenFPGA architecture definition
read_openfpga_arch -f ${OPENFPGA_ARCH_FILE}

# Read OpenFPGA simulation settings
read_openfpga_simulation_setting -f ${OPENFPGA_SIM_SETTING_FILE}

# Read OpenFPGA bitstream settings
read_openfpga_bitstream_setting -f ${OPENFPGA_BITSTREAM_SETTING_FILE}

# Read OpenFPGA clock architecture
read_openfpga_clock_arch -f ${OPENFPGA_CLOCK_ARCH_FILE}

# Append clock network to vpr's routing resource graph
append_clock_rr_graph

# Annotate the OpenFPGA architecture to VPR data base
# to debug use --verbose options
link_openfpga_arch --sort_gsb_chan_node_in_edges --allow_gsb_dangling_opin  

# Apply fix-up to clustering nets based on routing results
pb_pin_fixup --verbose #--map_global_net_to_msb

# Route clock based on clock network definition
route_clock_rr_graph --disable_unused_trees --disable_unused_spines --pin_constraints_file ${OPENFPGA_PIN_CONSTRAINTS_FILE}

# Apply fix-up to Look-Up Table truth tables based on packing results
lut_truth_table_fixup

# Build the module graph
#  - Enabled compression on routing architecture modules
#  - Disable pin duplication on grid modules due to PD strategy
build_fabric --compress_routing --load_fabric_key ${EXTERNAL_FABRIC_KEY_FILE} --frame_view --group_tile ${OPENFPGA_TILE_CONFIG_FILE} --group_config_block --name_module_using_index #--verbose
# Rename modules with a given rule
rename_modules --file ${OPENFPGA_RENAME_MODULE_FILE}

# Repack the netlist to physical pbs
# This must be done before bitstream generator and testbench generation
# Strongly recommend it is done after all the fix-up have been applied
repack #--design_constraints ${OPENFPGA_REPACK_CONSTRAINTS_FILE} --ignore_global_nets_on_pins clb.I[0:25]

# Skip architecture bitstream output because it is mainly for debugging
# The file is very large, which will cause extra I/O time
build_architecture_bitstream #--write_file arch_bitstream.xml

# Do NOT output any time stamp in output files, which is eaiser for version control
build_fabric_bitstream
write_fabric_bitstream --format plain_text --file ${OPENFPGA_BITSTREAM_BIT_FILE} --no_time_stamp
write_fabric_bitstream --format xml --file ${OPENFPGA_BITSTREAM_XML_FILE} --no_time_stamp --trim_path --value_only --filter_value 0
write_io_mapping -f ${OPENFPGA_BITSTREAM_PIN_MAP_FILE} --no_time_stamp

# Finish and exit OpenFPGA
exit

# Note :
# To run verification at the end of the flow maintain source in ./SRC directory
