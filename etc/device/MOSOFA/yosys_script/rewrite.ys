plugin -i yosys-sofa
# Reserved lines for read benchmark files (design sources in verilog format)
read_verilog ${BENCHMARK_VERILOG_FILES}
read_slang ${BENCHMARK_SYSTEMVERILOG_FILES}
synth_sofa -family ${DEVICE_FAMILY} -top ${TOP_MODULE} -parse_only
techmap -map +/adff2dff.v
write_verilog -noattr -nohex ${REFERENCE_VERILOG_REWRITE}
