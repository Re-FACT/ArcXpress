#include "arkangel_version.h"

//This file is automatically processed by CMAKE and replaces
//the values between ampersand's with the releveant CMAKE variable
//before being compiled.
namespace arkangel {
    const char* VERSION = "@ARKANGEL_VERSION@";
    const char* VERSION_SHORT = "@ARKANGEL_VERSION_SHORT@";

    const size_t VERSION_MAJOR = @ARKANGEL_VERSION_MAJOR@;
    const size_t VERSION_MINOR = @ARKANGEL_VERSION_MINOR@;
    const size_t VERSION_PATCH = @ARKANGEL_VERSION_PATCH@;
    const char* VERSION_PRERELEASE = "@ARKANGEL_VERSION_PRERELEASE@";

    const char* VCS_REVISION = "@ARKANGEL_VCS_REVISION@";
    const char* VCS_REVISION_SHORT = "@ARKANGEL_VCS_REVISION_SHORT@";

    const char* COMPILER = "@ARKANGEL_COMPILER_INFO@";
    const char* BUILD_TIMESTAMP = "@ARKANGEL_BUILD_TIMESTAMP@";
    const char* BUILD_INFO = "@ARKANGEL_BUILD_INFO@";
}
